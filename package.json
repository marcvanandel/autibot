{
  "name": "grounded-qa-mvp",
  "version": "1.0.0",
  "description": "Autibot is een Nederlandstalig projectidee voor een chatbot/chatinterface op basis van een LLM (Large Language Model), die vragen beantwoordt over ASS (Autisme Spectrum Stoornis) — voor mensen met autisme zelf, voor ouders/naasten, voor professionals en voor een breed publiek.",
  "scripts": {
    "dev": "concurrently \"vite build --watch --config client/vite.config.ts\" \"tsx --env-file-if-exists=.env src/index.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client/tsconfig.json",
    "slides": "marp --html docs/presentaties/2026-09-01-wat-is-autibot-en-waarom.md -o docs/presentaties/2026-09-01-wat-is-autibot-en-waarom.html",
    "slides:dev": "marp --html --server --watch docs/presentaties"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.2.0",
    "openai": "^6.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
