{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    // "bundler" i.p.v. "node": TypeScript 7 ondersteunt "node" niet meer als moduleResolution-waarde.
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "lib": ["ES2020"],
    "types": ["node"]
  },
  "include": ["src"]
}
